# 本地开发环境变量模板
# 复制本文件为 .env 并填入真实值;.env 已被 .gitignore 忽略,不会提交
# 启动时(在 tarot-api/ 目录下运行)spring-dotenv 会自动加载 .env

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=tarot
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 邮件 (QQ 邮箱 SMTP) =====
# 在 QQ 邮箱「设置 → 账号」开启 SMTP 服务后，填入生成的授权码；不要填写 QQ 登录密码
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_qq_number@qq.com
MAIL_PASSWORD=your_qq_smtp_authorization_code
MAIL_FROM=your_qq_number@qq.com

# ===== 登录 JWT =====
# 请生成随机 Base64 密钥，例如 PowerShell: [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_JWT_SECRET=replace_with_a_random_base64_secret_at_least_32_bytes
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=30

# ===== LLM (智谱 GLM,OpenAI 兼容) =====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_llm_api_key
LLM_MODEL=glm-4-flash
