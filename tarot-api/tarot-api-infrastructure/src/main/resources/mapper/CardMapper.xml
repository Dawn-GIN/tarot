<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dawn.tarot.infrastructure.mapper.CardMapper">

    <resultMap id="cardResult" type="com.dawn.tarot.domain.model.Card">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="nameEn" column="name_en"/>
        <result property="arcana" column="arcana"/>
        <result property="suit" column="suit"/>
        <result property="rank" column="rank"/>
        <result property="image" column="image"/>
        <result property="uprightMeaning" column="upright_meaning"/>
        <result property="reversedMeaning" column="reversed_meaning"/>
    </resultMap>

    <sql id="cardColumns">
        id, name, name_en, arcana, suit, `rank`, image, upright_meaning, reversed_meaning
    </sql>

    <select id="selectAll" resultMap="cardResult">
        SELECT <include refid="cardColumns"/>
        FROM card
        ORDER BY id
    </select>

    <select id="selectById" resultMap="cardResult">
        SELECT <include refid="cardColumns"/>
        FROM card WHERE id = #{id}
    </select>
</mapper>
